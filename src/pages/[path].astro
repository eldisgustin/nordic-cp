---
import { eq } from "drizzle-orm";
import { PagesIndex } from "~/consts/pages_index";
import * as nordic from "~/db/nordic";
import Main from "~/layouts/main_layout.astro";
import { canSeePage } from "~/lib/permissions";

const { path } = Astro.params;

if (!canSeePage(Astro.url.pathname, Astro.locals.user)) {
  return Atro.redirect(PagesIndex.Unauthorized);
}

if (!path) {
  return Astro.redirect(PagesIndex.NotFound);
}

const [page] = await nordic.db
  .select()
  .from(nordic.page)
  .where(eq(nordic.page.path, `/${path}`))
  .limit(1);

if (!page) {
  return Astro.redirect(PagesIndex.NotFound);
}
---

<Main title={page.title}>
  <article class="prose max-w-full">
    <Fragment set:html={page.body} />
  </article>
</Main>
