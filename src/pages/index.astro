---
import { eq } from "drizzle-orm";
import * as nordic from "~/providers/nordic/db";
import Main from "~/layouts/main_layout.astro";

const [page] = await nordic.db
  .select()
  .from(nordic.page)
  .where(eq(nordic.page.path, `/`))
  .limit(1);
---

<Main title={page.title}>
  <article class="prose">
    <Fragment set:html={page.body} />
  </article>
</Main>
