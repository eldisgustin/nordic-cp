---
import { eq } from "drizzle-orm";
import AccountView from "~/components/ui/view_account.astro";
import { PagesIndex } from "~/consts/pages_index";
import * as athena from "~/db/athena";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import AccountLayout from "~/layouts/account_layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { user } = Astro.locals;

if (!user) {
  return Astro.redirect(PagesIndex.SignIn);
}

const [roAccount] = await athena.db
  .select()
  .from(athena.login)
  .where(eq(athena.login.email, user.email))
  .limit(1);
---

<AccountLayout title={t("account.title")}>
  <AccountView roAccount={roAccount} />
</AccountLayout>
