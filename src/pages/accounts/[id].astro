---
import { eq } from "drizzle-orm";
import AccountView from "~/components/ui/view_account.astro";
import { PagesIndex } from "~/consts/pages_index";
import * as athena from "~/providers/athena/db";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import AccountLayout from "~/layouts/account_layout.astro";
import { isAllowedTo } from "~/lib/permissions";

if (!(await isAllowedTo("account:view", Astro.locals.user))) {
  return Astro.redirect(PagesIndex.Unauthorized);
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [roAccount] = await athena.db
  .select()
  .from(athena.login)
  .where(eq(athena.login.accountId, Number(Astro.params.id)));

if (!roAccount) {
  return Astro.redirect(PagesIndex.NotFound);
}
---

<AccountLayout title={t("account.title")}>
  <main>
    <AccountView roAccount={roAccount} />
  </main>
</AccountLayout>
