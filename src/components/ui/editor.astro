---
import "jodit/es2021/jodit.min.css";

const { value, ...props } = Astro.props;
---

<textarea
  id="editor"
  class="prose w-full prose-slate skeleton bg-base-300 h-40"
  {...props}
>
  <Fragment set:html={value} />
</textarea>

<script>
  import { Jodit } from "jodit";

  const container = document.getElementById("editor")!;

  Jodit.make(container, { theme: "nordic" });
</script>
