---
import { Icon } from "astro-icon/components";
import { eq } from "drizzle-orm";
import { PageLocation } from "~/consts/page_location";
import { PagesIndex } from "~/consts/pages_index";
import * as nordic from "~/db/nordic";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pages = await nordic.db
  .select()
  .from(nordic.page)
  .where(eq(nordic.page.location, PageLocation.Navbar));
---

<div class="navbar bg-base-200 border-y border-base-100 shadow">
  <div class="navbar-start"></div>
  <ul class="navbar-center space-x-4">
    {
      pages.map((page) => {
        return (
          <li>
            <a href={page.path} class="link-hover flex gap-1 items-center">
              <Icon name={page.icon} />
              {page.title}
            </a>
          </li>
        );
      })
    }
    <li>
      <a
        class="link-hover flex gap-1 items-center"
        href={PagesIndex.WhoIsOnline}
      >
        <Icon name="mdi:question-mark" />
        {t("navbar.who_is_online")}
      </a>
    </li>
    <li>
      <a class="link-hover flex gap-1 items-center" href={PagesIndex.MyAccount}>
        <Icon name="mdi:user" />
        {t("navbar.account")}
      </a>
    </li>
  </ul>
  <div class="navbar-end"></div>
</div>
